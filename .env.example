# Satu-satunya file env: salin ke .env di root lalu sesuaikan bila perlu.
# (npm script prisma:* otomatis memuat root .env via dotenv-cli)
# DB Docker (docker-compose.yml): MariaDB 11 di localhost:3307
# Runtime app: user hino. Untuk `prisma migrate dev` (butuh CREATE DATABASE
# untuk shadow DB), pakai root: mysql://root:root@localhost:3307/hino_calibration
DATABASE_URL="mysql://hino:hino_pass@localhost:3307/hino_calibration"
PORT=3000
JWT_SECRET=ganti_dengan_secret_yang_kuat
