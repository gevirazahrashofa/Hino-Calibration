# Salin ke .env dan sesuaikan dengan XAMPP lokal
# XAMPP default: user=root, password kosong, port 3306
DATABASE_URL="mysql://root:@localhost:3306/hino_calibration"
PORT=3000
JWT_SECRET=ganti_dengan_secret_yang_kuat

# Opsional (kompatibilitas lama, tidak lagi dipakai langsung oleh mysql2 pool):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=hino_calibration
