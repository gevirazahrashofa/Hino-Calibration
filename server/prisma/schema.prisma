// Prisma schema — sumber kebenaran DB (MariaDB via Docker, provider mysql).
// Jalankan: docker compose up -d db && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum StatusAlat {
  active
  cancelled
}

enum TipeAlat {
  torque
  non_torque @map("non-torque")
}

enum StatusPengajuan {
  pending
  approved
  rejected
}

enum KategoriPengajuan {
  registration
  cancellation
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique @db.VarChar(50)
  password    String   @db.VarChar(255)
  role        Role     @default(user)
  namaLengkap String?  @map("nama_lengkap") @db.VarChar(100)
  email       String?  @unique @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("users")
}

model AlatUkur {
  id            Int        @id @default(autoincrement())
  namaAlat      String     @map("nama_alat") @db.VarChar(150)
  controlNumber String     @unique @map("control_number") @db.VarChar(80)
  model         String     @db.VarChar(100)
  serialNumber  String     @map("serial_number") @db.VarChar(100)
  settingNm     String?    @map("setting_nm") @db.VarChar(50)
  rangeAlat     String?    @map("range_alat") @db.VarChar(100)
  akurasi       String?    @db.VarChar(100)
  process       String     @db.VarChar(100)
  status        StatusAlat @default(active)
  grp           String     @db.VarChar(100)
  lineName      String     @map("line_name") @db.VarChar(100)
  kodeLine      String?    @map("kode_line") @db.VarChar(50)
  lokasi        String     @db.VarChar(150)
  maker         String?    @db.VarChar(100)
  master        String?    @db.VarChar(100)
  noSeri        String?    @map("no_seri") @db.VarChar(100)
  tipe          TipeAlat   @default(torque)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  riwayatPembatalan RiwayatPembatalan[]
  pengajuan         Pengajuan[]

  @@map("alat_ukur")
}

model RiwayatPembatalan {
  id            Int      @id @default(autoincrement())
  alatId        Int      @map("alat_id")
  alat          AlatUkur @relation(fields: [alatId], references: [id], onDelete: Cascade)
  alasan        String?  @db.VarChar(255)
  dibatalkanOleh String? @map("dibatalkan_oleh") @db.VarChar(100)
  tanggal       DateTime @default(now()) @db.Timestamp(0)

  @@map("riwayat_pembatalan")
}

model Pengajuan {
  id               Int              @id @default(autoincrement())
  kategori         KategoriPengajuan
  alatId           Int?             @map("alat_id")
  alat             AlatUkur?        @relation(fields: [alatId], references: [id], onDelete: SetNull)
  tanggalPengajuan DateTime?        @map("tanggal_pengajuan") @db.Date
  maker            String?          @db.VarChar(100)
  namaAlat         String           @map("nama_alat") @db.VarChar(150)
  serialNumber     String           @map("serial_number") @db.VarChar(100)
  model            String           @db.VarChar(100)
  akurasi          String?          @db.VarChar(100)
  rangeAlat        String?          @map("range_alat") @db.VarChar(100)
  setting          String?          @db.VarChar(100)
  penggunaan       String?          @db.VarChar(150)
  penempatan       String?          @db.VarChar(150)
  kategoriAlat     String?          @map("kategori_alat") @db.VarChar(50)
  klasifikasi      String?          @db.VarChar(50)
  alasanPerubahan  String?          @map("alasan_perubahan") @db.Text
  dokumen          String?          @db.VarChar(255)
  ttdPemohon       String?          @map("ttd_pemohon") @db.LongText
  pemohon          String           @db.VarChar(50)

  dept             String?          @db.VarChar(100)
  kelengkapan      String?          @db.VarChar(255)
  controlNo        String?          @map("control_no") @db.VarChar(80)
  tipe             String?          @db.VarChar(20)
  grp              String?          @db.VarChar(100)
  lineName         String?          @map("line_name") @db.VarChar(100)
  kodeLine         String?          @map("kode_line") @db.VarChar(50)
  catatan          String?          @db.Text
  ttdPenerima      String?          @map("ttd_penerima") @db.LongText
  kalibrator       String?          @db.VarChar(100)
  tanggalKalibrasi DateTime?        @map("tanggal_kalibrasi") @db.Date
  judgement        String?          @db.VarChar(20)
  alasanNg         String?          @map("alasan_ng") @db.Text
  flowProcess      String?          @map("flow_process") @db.VarChar(150)
  ttdDiterimaOleh  String?          @map("ttd_diterima_oleh") @db.LongText
  catatanSerah     String?          @map("catatan_serah") @db.Text
  ttdDiserahkanOleh String?         @map("ttd_diserahkan_oleh") @db.LongText

  status     StatusPengajuan @default(pending)
  reviewedBy String?         @map("reviewed_by") @db.VarChar(50)
  reviewedAt DateTime?       @map("reviewed_at") @db.Timestamp(0)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("pengajuan")
}

model Pengaturan {
  id           Int    @id @default(autoincrement())
  namaAplikasi String @default("Hino Calibration") @map("nama_aplikasi") @db.VarChar(100)
  versi        String @default("1.0.0") @db.VarChar(20)

  @@map("pengaturan")
}
